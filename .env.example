DATABASE_URL=postgresql://postgres:change_me@localhost:5432/queue_management
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_STAFF_ACCESS_SECRET=replace_with_a_different_random_secret_at_least_32_characters
AUTH_REFRESH_COOKIE_SECURE=false
GMAIL_USER=your-test-account@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
GMAIL_FROM="Queue Management <your-test-account@gmail.com>"
